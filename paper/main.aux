\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Architecture of the pipeline. \textbf  {Input}: cutting condition, tool and machine, force and sensor constants, fault specification and real healthy cuts, all tagged in a provenance registry. \textbf  {Simulation}: a regenerative milling model and a sensor chain give the fault effect $\Delta $ as the difference between a faulty and a healthy run; a baseline fitted to real spectra supplies the healthy signal. \textbf  {RCA}: 30 features give 14 nodes, six causal algorithms rank them, and synthetic tests and real-data checks measure the three parts of the simulation gap.}}{7}{figure.caption.9}\protected@file@percent }
\newlabel{fig:architecture}{{2}{7}{Architecture of the pipeline. \textbf {Input}: cutting condition, tool and machine, force and sensor constants, fault specification and real healthy cuts, all tagged in a provenance registry. \textbf {Simulation}: a regenerative milling model and a sensor chain give the fault effect $\Delta $ as the difference between a faulty and a healthy run; a baseline fitted to real spectra supplies the healthy signal. \textbf {RCA}: 30 features give 14 nodes, six causal algorithms rank them, and synthetic tests and real-data checks measure the three parts of the simulation gap}{figure.caption.9}{}}
