# Copy to ".env" (same folder, git-ignored) and fill in YOUR key. Do not paste the key in chat or commit it.
OPENROUTER_API_KEY=
# Model slug. Default is a small, cheap model (google/gemma-3-4b-it, supports structured outputs on OpenRouter as of 13 Oct 2026). Output that fails validation is rejected and replaced by the rule-based text.
# Other cheap options seen in the OpenRouter model list: google/gemma-4-26b-a4b-it, anthropic/claude-haiku-5.5
OPENROUTER_MODEL=google/gemma-3-4b-it
